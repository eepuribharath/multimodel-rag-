# ==============================================================================
# Multimodal RAG Configuration
# ==============================================================================

# --- Mode 1: 100% Local / Zero API Key (Offline & Private) ---
EMBEDDER=local                          # local | gemini
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384                           # 384 for all-MiniLM-L6-v2, 3072 for gemini-embedding-2
GENERATOR=local                         # local | gemini
LOCAL_GEN_MODEL=Qwen/Qwen2.5-0.5B-Instruct
GEN_TEMPERATURE=0.1
GEN_MAX_TOKENS=512

# --- Mode 2: Cloud Gemini (Optional, requires Google Gemini API key) ---
# GEMINI_API_KEY=
# EMBEDDER=gemini
# EMBED_MODEL=gemini-embedding-2
# EMBED_DIM=3072
# GENERATOR=gemini
# GEN_MODEL=gemini-3.5-flash

# --- Reranker (Cross-encoder reranking) ---
RERANKER=local                          # local | fake | cohere
RERANK_MODEL=BAAI/bge-reranker-v2-m3    # Hugging Face model id, cached locally
COHERE_API_KEY=
RERANK_TOP_K=6

# --- Vector Database & Retrieval ---
QDRANT_URL=local                        # local (embedded qdrant_data) | http://localhost:6333 | :memory:
QDRANT_COLLECTION=local_rag             # local_rag for 384-dim, multimodal_rag for 3072-dim
RETRIEVE_TOP_K=100
RRF_K=60

# --- History ---
HISTORY_TURNS=6

# --- Observability (Optional) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
